# Stage 11 — Supabase credentials for the local matching-poll agent. Copy to
# local-agent/.env (gitignored) and fill in from the Supabase dashboard
# (Project Settings -> API) for the conference-lead-gen project.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely — never commit it, never
# put it anywhere a browser could read it. This file only ever lives on the
# machine running the agent.
SUPABASE_URL=https://yrvppufkerbjpvrxniot.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides (defaults shown):
# MATCH_POLL_INTERVAL_MS=20000
# PHOTO_POLL_INTERVAL_MS=20000
# TRANSCRIPTION_POLL_INTERVAL_MS=20000
# WHISPER_MODEL=base
# WHISPER_TIMEOUT_MS=300000

# Stage 14 (revised): voice-memo transcription runs via a local `whisper`
# CLI (pip install openai-whisper), not OpenAI's API — no key needed here.
# Requires ffmpeg on PATH (brew install ffmpeg) and the whisper CLI
# reachable on PATH. Already verified present on this machine.
