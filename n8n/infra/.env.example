# Copy to .env next to docker-compose.yml and fill in real values.
# NEVER commit the real .env — it holds the single highest-consequence
# secret in this stack (N8N_ENCRYPTION_KEY; see plan "Secrets/backup posture").

# Generate with: openssl rand -hex 32
# Losing this makes every credential n8n stores permanently undecryptable —
# store a copy in a password manager OUTSIDE this VPS's own disk.
N8N_ENCRYPTION_KEY=

# Separate from any Supabase/production Postgres password.
N8N_DB_PASSWORD=

# The domain Caddy will serve the n8n editor/webhooks on.
N8N_HOST=
N8N_WEBHOOK_URL=

# Hours of n8n execution history to retain (see EXECUTIONS_DATA_PRUNE).
N8N_EXECUTIONS_DATA_MAX_AGE=336

# Whisper service image + model size. "medium" matches local-agent's own
# whisper-runner.mjs default (bumped from "small" for accuracy — see that
# file's comments). Confirm the chosen image supports `initial_prompt` over
# HTTP before relying on transcription-accuracy parity (Stage 3).
WHISPER_IMAGE=onerahmet/openai-whisper-asr-webservice:latest
WHISPER_MODEL=medium
