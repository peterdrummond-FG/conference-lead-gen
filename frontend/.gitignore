.DS_Store
.thumbs.db
node_modules

# .env files (the example file is the one place a new developer learns the
# variable names, so it must stay tracked; it was ignored by this very pattern
# until 2026-10-12, which left a fresh clone with nothing to copy)
.env*
!.env.example

# Quasar core related directories
.quasar
/dist
/quasar.config.*.temporary.compiled*

# Cordova related directories and files
/src-cordova/node_modules
/src-cordova/platforms
/src-cordova/plugins
/src-cordova/www

# Capacitor related directories and files
/src-capacitor/www
/src-capacitor/node_modules

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
