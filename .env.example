# Postgres connection string used by the backend (ASP.NET Core config
# binding maps ConnectionStrings__Default -> ConnectionStrings:Default).
ConnectionStrings__Default=Host=localhost;Port=5432;Database=conference_lead_gen;Username=your_local_user

# Zoho OAuth connected app — read access to Campaigns/Contacts/Accounts,
# read-write to Contacts/Accounts for the "create Account" step (Stage 2+).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
