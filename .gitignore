# Env
.env

# Node
node_modules/
dist/

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store

# The card watcher and local agent were retired 2026-10-08 and their folders are
# gone from the repo, but an old checkout or a laptop that ran them can still hold
# real card photos, voice memos and run state under these paths. The ignores stay so
# that material can never be committed by accident.
watcher/inbox/
watcher/.processing/
watcher/processed/
watcher/failed/
watcher/logs/
local-agent/logs/
local-agent/.processing-sms/
local-agent/.processing-audio/

# Local scratch — denoising comparisons for the old voice-memo transcription work.
# Real recordings of real people; never commit them.
audio check/

# Local security/quality audit write-up. Notes about this repo rather than
# part of it, and they name specific weaknesses — kept out of the remotes.
audit/
