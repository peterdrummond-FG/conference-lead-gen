# Env
.env

# .NET
bin/
obj/
*.user

# Node
node_modules/
dist/

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store

# Seed loader run artifacts (regenerated each run, not source data)
backend/Data/Seed/*.excluded.json

# Card-photo watcher — real photos and run state, never version-controlled.
# The script itself and this .gitignore's own placeholders stay tracked.
watcher/inbox/*
!watcher/inbox/.gitkeep
watcher/.processing/*
!watcher/.processing/.gitkeep
watcher/processed/*
!watcher/processed/.gitkeep
watcher/failed/*
!watcher/failed/.gitkeep
watcher/logs/*
!watcher/logs/.gitkeep

# Local matching-poll agent (Stage 11) — run state, never version-controlled.
local-agent/logs/*
!local-agent/logs/.gitkeep

# Stage 13/14 scratch dirs — downloaded SMS photos/audio, purely transient
# (the durable copy is always Supabase Storage), cleaned up after each run.
local-agent/.processing-sms/
local-agent/.processing-audio/
